{
  "name": "myathena",
  "productName": "myAthena",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Assisted Assessment and Proctoring Platform",
  "type": "module",
  "main": "./electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --mac dmg",
    "dist:arm64": "vite build && electron-builder --mac dmg --arm64",
    "dist:universal": "vite build && electron-builder --mac dmg --universal",
    "pack": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.ekanshkhatri.myathena",
    "productName": "myAthena",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "myAthena Installer"
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
